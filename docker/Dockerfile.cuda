ARG BASE_IMAGE=vllm/vllm-openai:v0.26.0
FROM ${BASE_IMAGE}

ARG COMMON_WORKDIR=/app

WORKDIR ${COMMON_WORKDIR}

# Step 1: Setup - Install system dependencies
RUN apt-get update && \
    apt-get install -y git jq && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# `python` (not just `python3`) must exist before any third-party setup.py that
# shells out to a bare `python` (SpargeAttn's csrc/qattn instantiation autogen
# does exactly this via os.system(), silently, with no return-code check) —
# moved here from the end of this file so every later RUN step can see it.
RUN ln -sf /usr/bin/python3 /usr/bin/python

# ==========================================================================
# 固化依赖层(与源码无关)——放在 `COPY . ` 之前,源码改动不会失效这些层,
# 每次出包只重跑最后的 app 安装层。改这段顺序前请留意:下面每一层都不引用
# 仓库源码,故可安全前置;真正依赖源码的只有末尾的 `COPY .` + `pip install .`。
# ==========================================================================

# Step 2b: Third-party runtime deps for community speech/singing models.
#   voxcpm (VoxCPM2), s3tokenizer (CosyVoice3), funasr (SoulX ASR / MOSS),
#   BS-RoFormer (SoulX vocal-sep + F0 — SVC & 集成 preprocess 都要),
#   g2pM/g2p-en/ToJyutping (SoulX 集成 preprocess 的中/英/粤 G2P),
#   fugashi+unidic-lite (IndexTTS-2.5 日语分词 —— pyproject 的 [indextts2] extra 里,
#     但那个 extra 从未被安装过,导致 lang=ja 直接 400
#     "Japanese preprocessing requires fugashi and unidic";两者在 aarch64 上都有现成
#     产物(fugashi 有 manylinux2014_aarch64 wheel、unidic-lite 是纯词典数据),
#     实测 17s 装完,与同 extra 里那个要编 OpenFst 的 WeTextProcessing 完全不同 ——
#     后者已由 text_processing_v2_5 的 wetext 回落绕开,不在此安装).
# Best-effort per-package so a missing arm64 wheel can't fail the whole build —
# the model needing a skipped dep surfaces a clear ImportError at serve time.
# NOTE: install the individual g2p packages, NOT `pip install -e ".[soulx-svs]"`
# (that reinstalls vllm-omni editable in-place — a footgun; Phase 2 POC 踩过).
RUN PY="$(python3 -c 'import sys; print(sys.executable)')"; \
    for pkg in "voxcpm>=2.0.2" "s3tokenizer>=0.3.0" "torchdiffeq>=0.2.5" "cn2an>=0.5.22" "funasr>=1.0.0" \
               "BS-RoFormer" "g2pM>=0.1.2.5" "g2p-en>=2.1.0" "ToJyutping>=3.2.0" \
               "fugashi>=1.2.0" "unidic-lite>=1.0.8"; do \
      uv pip install --python "$PY" --no-cache-dir "$pkg" || echo "WARN: failed to install $pkg (model needing it won't serve)"; \
    done

# Step 2b-2: NLTK data for g2p-en (SoulX 集成 preprocess 的英文 G2P 初始化会在运行时
# 下这些;离线节点下不了 → 构建时预置)。新旧 NLTK 的 tagger 名不同,两个都装。
ENV NLTK_DATA=/usr/local/share/nltk_data
RUN python3 -m nltk.downloader -d /usr/local/share/nltk_data \
      averaged_perceptron_tagger averaged_perceptron_tagger_eng cmudict \
      || echo "WARN: nltk data download failed (English SVS 集成 preprocess may need it)"

# Step 2d: SpargeAttn (thu-ml) — compiled CUDA kernel for the SLA_SAGE2_ATTN
# diffusion attention backend (MiniMax-H3 sage2 block-sparse path). Only
# CTA_Q=128/CTA_K=64 is compiled upstream for sm80/86/87 — fleet is A100
# (sm80). --no-build-isolation is required: setup.py imports torch at module
# level, which breaks pip's default isolated build env. The image build host
# has no GPU/driver, so the real libcuda.so (driver API, distinct from the
# CUDA toolkit's own libcudart) doesn't exist — the final link step needs the
# toolkit's driver-stub library instead, via LIBRARY_PATH. The base image's
# CUDA toolkit also ships nvcc/libcudart but NOT the dev sub-packages for the
# math libs torch's ATen/cuda/CUDAContext.h transitively pulls in (cusparse.h,
# cublas_v2.h, ... — discovered one apt package at a time via build-log
# fatal errors) — install the matching dev packages up front instead.
# Best-effort throughout: a failure here shouldn't fail the whole image,
# SLA_SAGE2_ATTN just surfaces a clear "backend unavailable" error at serve time.
RUN CUDA_VER_DASH="$(nvcc --version | sed -n 's/^Cuda compilation tools, release \([0-9]*\.[0-9]*\).*/\1/p' | tr '.' '-')"; \
    (apt-get update && apt-get install -y --no-install-recommends \
        "libcusparse-dev-${CUDA_VER_DASH}" "libcublas-dev-${CUDA_VER_DASH}" \
        "libcusolver-dev-${CUDA_VER_DASH}" "libcurand-dev-${CUDA_VER_DASH}" \
        "libcufft-dev-${CUDA_VER_DASH}" \
      && apt-get clean && rm -rf /var/lib/apt/lists/*) \
      || echo "WARN: failed to install CUDA math-lib dev headers for ${CUDA_VER_DASH} (SpargeAttn build may fail)"
RUN (git clone --depth 1 https://github.com/thu-ml/SpargeAttn.git /tmp/SpargeAttn \
      && cd /tmp/SpargeAttn \
      && TORCH_CUDA_ARCH_LIST=8.0 LIBRARY_PATH="/usr/local/cuda/lib64/stubs${LIBRARY_PATH:+:$LIBRARY_PATH}" \
         pip install . --no-build-isolation \
      && rm -rf /tmp/SpargeAttn) \
      || echo "WARN: SpargeAttn build failed (SLA_SAGE2_ATTN backend won't be available)"

# Step 2e: SLA (thu-ml, arXiv 2509.24006) — the `sparse_linear_attention`
# package behind the SLA_ATTN diffusion attention backend, and the source of the
# `get_block_map` block selection SLA_SAGE2_ATTN imports as well (so sage2 needs
# BOTH this and SpargeAttn above). Pure Triton, no CUDA build — seconds to
# install and arch-agnostic, unlike Step 2d.
# Placed AFTER Step 2d on purpose: a new layer inserted before the SpargeAttn
# build would invalidate its cache entry and re-run that CUDA compile on every
# image.
# Best-effort is safe here despite both backends hard-requiring the package:
# selecting either one without it aborts startup by design (a sparsity-distilled
# checkpoint served on the dense path returns valid but off-distribution video,
# so a silent fallback would be invisible to callers and monitoring). A failed
# install therefore surfaces loudly at serve time, not as bad output.
# The isolated install is tried first; SLA's setup.py may import torch at module
# level the way SpargeAttn's does, which only builds with --no-build-isolation.
RUN pip install --no-cache-dir "git+https://github.com/thu-ml/SLA.git" \
      || pip install --no-cache-dir --no-build-isolation "git+https://github.com/thu-ml/SLA.git" \
      || echo "WARN: SLA install failed (SLA_ATTN / SLA_SAGE2_ATTN backends won't be available)"

# Step 2c: Bake the A100 40G x2 deploy-configs for the 8B MOSS models (TTSD /
# SoundEffect / VoiceGenerator) + SoulX-Singer SVS/SVC to a stable in-image path
# so GPUStack can reference them via `--deploy-config /deploy-configs/<x>.yaml`.
# These COPYs use specific paths, so they only invalidate when those files change
# (not on every source edit); kept before `COPY .` to isolate them.
COPY deploy-configs/ /deploy-configs/
COPY vllm_omni/deploy/soulxsinger_svs.yaml vllm_omni/deploy/soulxsinger_svc.yaml /deploy-configs/

# NOTE(离线 HF cache,不烤进镜像):SoulX SVC 的 WhisperEncoder 加载
# `openai/whisper-base`(~1.1G);AudioX 需 `t5-base` + `openai/clip-vit-base-patch32`;
# MOSS 家族需 `OpenMOSS-Team/MOSS-Audio-Tokenizer[-Nano]`。这些与模型权重一样走
# NFS 的 HF cache(HF_HOME),由部署侧预填(见 memory: vllm-omni-phase2-image-deps /
# vllm-omni-gpustack-deploy-prereqs),镜像只带 pip 依赖,保持精简。

# ==========================================================================
# 应用层——源码放最后,只让下面这层失效(改源码出包只重跑这一步,秒级)。
# 保留完整 `pip install .`(带依赖):base(vllm 官方镜像)+ 上面固化层已覆盖
# 绝大多数依赖,uv 会跳过已满足项;不用 --no-deps,避免漏装 pyproject 里 base
# 没带的依赖。
# ==========================================================================
# Step 2: Copy vllm-omni code and install
RUN mkdir -p ${COMMON_WORKDIR}/vllm-omni
COPY . ${COMMON_WORKDIR}/vllm-omni
RUN cd ${COMMON_WORKDIR}/vllm-omni && uv pip install --python "$(python3 -c 'import sys; print(sys.executable)')" --no-cache-dir "."

ENTRYPOINT []
