# 本分支(Qwen-Image-2.1)的代码基线含 #7230『Rebase to vLLM 0.29.0』,
# 上游只 bump 了 docker/Dockerfile.ci 的 VLLM_BASE_TAG,这份运行时 Dockerfile
# 漏了 —— 用 0.28 基座配 0.29 代码会在启动时才炸,所以这里跟上。
ARG BASE_IMAGE=vllm/vllm-openai:v0.29.0
FROM ${BASE_IMAGE}

ARG COMMON_WORKDIR=/app

WORKDIR ${COMMON_WORKDIR}

# Step 1: Setup - Install system dependencies
RUN apt-get update && \
    apt-get install -y git jq && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p ${COMMON_WORKDIR}/vllm-omni

# Step 2: Copy vllm-omni code and install
COPY . ${COMMON_WORKDIR}/vllm-omni
RUN cd ${COMMON_WORKDIR}/vllm-omni && uv pip install --python "$(python3 -c 'import sys; print(sys.executable)')" --no-cache-dir "."

# TorchAO —— weight-only 量化（W8A16，torchao_int8_weight_only 档）用。
# 必须放在 `uv pip install .` **之后**：装在它前面会让 uv 构建 vllm-omni 的 wheel 时
# 报 packaging.version.InvalidVersion: Invalid version: 'dev'。
# best-effort：torchao 与 torch 版本绑定很紧，装不上不该让整个镜像构建失败 ——
# 缺它时只有 torchao_* 量化档在启动时报 ImportError，别的模型不受影响。
RUN PY="$(python3 -c 'import sys; print(sys.executable)')"; \
    uv pip install --python "$PY" --no-cache-dir --no-deps torchao \
      || echo "WARN: torchao 未装上，torchao_* 量化档不可用"

RUN ln -sf /usr/bin/python3 /usr/bin/python

ENTRYPOINT []
